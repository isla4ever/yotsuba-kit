{
  "name": "@iyotsuba/schedule-elements",
  "version": "0.7.2",
  "description": "Framework-agnostic <ys-schedule> custom element. Works in React, plain HTML, uni-app H5, Ionic — anywhere the DOM is.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/schedule-elements.iife.js",
  "module": "./dist/schedule-elements.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/schedule-elements.js",
      "default": "./dist/schedule-elements.iife.js"
    }
  },
  "files": [
    "dist",
    "types"
  ],
  "scripts": {
    "build": "vite build",
    "test": "echo 'covered by @iyotsuba/schedule-vue tests'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@iyotsuba/schedule-core": "workspace:^"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.2",
    "vue": "^3.5.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isla4ever/yotsuba-kit.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "./types/index.d.ts"
}
